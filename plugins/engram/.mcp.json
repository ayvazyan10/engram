{
  "mcpServers": {
    "engram": {
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "@engram-ai-memory/mcp@latest",
        "engram-mcp"
      ],
      "env": {
        "ENGRAM_DB_PATH": "${ENGRAM_DB_PATH:-~/.engram/engram.db}",
        "ENGRAM_SOURCE": "${ENGRAM_SOURCE:-claude-code}",
        "ENGRAM_NAMESPACE_MODE": "${ENGRAM_NAMESPACE_MODE:-project}",
        "ENGRAM_NAMESPACE": "${ENGRAM_NAMESPACE:-}",
        "ENGRAM_ADMIN_TOOLS": "${ENGRAM_ADMIN_TOOLS:-0}"
      }
    }
  }
}
