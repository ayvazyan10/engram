{
  "name": "@engram-ai-memory/server",
  "version": "0.6.0",
  "private": true,
  "description": "Engram REST API + WebSocket server",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@engram-ai-memory/core": "workspace:*",
    "@engram-ai-memory/mcp": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^5.2.2",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "d3-force": "3.0.0",
    "drizzle-orm": "^0.40.0",
    "fastify": "^5.2.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@engram-ai-memory/eslint-config": "workspace:*",
    "@engram-ai-memory/tsconfig": "workspace:*",
    "@types/d3-force": "3.0.10",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.1.1",
    "eslint": "^9.39.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.4",
    "typescript": "5.7.3",
    "vitest": "^3.1.1"
  }
}
