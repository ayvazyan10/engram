{
  "name": "@engram-ai-memory/core",
  "version": "0.7.0",
  "description": "The Brain — memory engine, embeddings, graph, and retrieval",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && pnpm run copy:pg-migrations",
    "copy:pg-migrations": "node -e \"const fs=require('fs');const src='src/db/pg/migrations';if(fs.existsSync(src)){fs.cpSync(src,'dist/db/pg/migrations',{recursive:true});}\"",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist *.tsbuildinfo",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:generate:pg": "drizzle-kit generate --config drizzle.pg.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.40.0",
    "lz4js": "^0.2.0",
    "uuid": "^11.1.0"
  },
  "optionalDependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@engram-ai-memory/eslint-config": "workspace:*",
    "@engram-ai-memory/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.1.1",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.39.0",
    "testcontainers": "^12.1.0",
    "typescript": "5.7.3",
    "vitest": "^3.1.1"
  }
}
