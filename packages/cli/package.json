{
  "name": "@engram-ai-memory/cli",
  "version": "0.3.2",
  "description": "Engram CLI \u2014 store, search, recall, and manage AI memories from the terminal",
  "type": "module",
  "bin": {
    "engram": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@engram-ai-memory/tsconfig": "workspace:*",
    "tsx": "^4.19.4",
    "typescript": "5.7.3",
    "vitest": "^3.1.1",
    "@vitest/coverage-v8": "^3.1.1"
  }
}
