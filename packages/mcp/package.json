{
  "name": "@engram-ai-memory/mcp",
  "version": "0.3.2",
  "description": "MCP Server \u2014 connects Engram brain to any AI client (Claude Code, Cursor, Windsurf, and more)",
  "main": "./dist/server.js",
  "bin": {
    "engram-mcp": "./dist/server.js",
    "engram-store-session": "./dist/store-session.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "@engram-ai-memory/core": "workspace:*",
    "uuid": "^11.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@engram-ai-memory/tsconfig": "workspace:*",
    "@types/uuid": "^10.0.0",
    "typescript": "5.7.3",
    "vitest": "^3.1.1",
    "@vitest/coverage-v8": "^3.1.1"
  }
}
